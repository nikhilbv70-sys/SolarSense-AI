# Copy to .env and fill in real values. Never commit the real .env file.

# PostgreSQL
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/solarsense

# Flask
SECRET_KEY=replace_with_a_long_random_string
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:4178,http://127.0.0.1:4178

# Google reCAPTCHA v2
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# India renewable energy government API (data.gov.in style key)
INDIA_RENEWABLE_API_KEY=your_government_api_key
INDIA_RENEWABLE_RESOURCE_ID=

# External data providers (NASA POWER and PVGIS need no key)
